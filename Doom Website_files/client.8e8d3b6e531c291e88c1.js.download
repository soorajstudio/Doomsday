/master/classes/cl.submitted.html)",type:"object",properties:{command:{type:"string",description:"Intent that resulted in logging this DiscreteAction"},parentView:{type:"string",description:"Name of the engaged parent view that triggered this action e.g. if more than one button with the same view name was clicked that triggered this action then the parent view name assigned to the button should be used here to distinguish between the two. However this field is optional and should only be used when the view by itself leads to ambiguity of where in the UI this action was triggered from."},view:{type:"string",description:"Name of the engaged view if any"},trackingInfo:{type:"object",properties:{},description:"Server-defined tracking information, if applicable."},navigationLevel:{type:"string",description:"Navigation level from session context"},connectionType:{type:"string",description:"Network connection type (e.g., WifiConnection, MobileConnection, WiredConnection)"},referrerUrl:{type:"string",description:"Referrer URL of the webpage where the event occurred"},uiLocale:{type:"string",description:"Application UI locale/language setting (e.g., en-US, es-ES)"}},required:["command"]},"cl.ViewDetailsCommand":{$schema:"http://json-schema.org/draft-07/schema#",title:"ViewDetailsCommand",description:"Migrated from CL event type: **ViewDetailsCommand**\n\nCategory: Session\n\nCriticality Level: L2\n\nType Hierarchy: ViewDetailsCommand → Command → Session\n\n[View CL documentation](https://manuals.netflix.net/view/cltypes/mkdocs/master/classes/cl.viewdetailscommand.html)",properties:{command:{description:"Command type name for Command-type events (e.g., PlayCommand)",type:"string"},connectionType:{description:"Network connection type (e.g., WifiConnection, MobileConnection, WiredConnection)",type:"string"},navigationLevel:{description:"Navigation level from session context",type:"string"},uiLocale:{description:"Application UI locale/language setting (e.g., en-US, es-ES)",type:"string"}},type:"object"},"cl.ViewDetailsCommandCanceled":{$schema:"http://json-schema.org/draft-07/schema#",title:"ViewDetailsCommandCanceled",description:"Migrated from CL event type: **SessionCanceled**\n\nCategory: SessionEnded\n\nCriticality Level: L3\n\nType Hierarchy: SessionCanceled → SessionEnded\n\n[View CL documentation](https://manuals.netflix.net/view/cltypes/mkdocs/master/classes/cl.sessioncanceled.html)\n\nEnding event for: ViewDetailsCommand (merged with SessionCanceled)",properties:{command:{description:"Command type name for Command-type events (e.g., PlayCommand)",type:"string"},connectionType:{description:"Network connection type (e.g., WifiConnection, MobileConnection, WiredConnection)",type:"string"},genreId:{description:"Genre ID with 3-level fallback: payload.trackingInfo → Focus.trackingInfo → NavigationLevel.trackingInfo","ntl-type":"int64",type:"integer"},lolomoId:{description:"Lolomo ID for presentation context",type:"string"},navigationLevel:{description:"Navigation level from session context",type:"string"},reason:{description:"An optional platform-defined string describing why the session was canceled.",type:"string"},uiLocale:{description:"Application UI locale/language setting (e.g., en-US, es-ES)",type:"string"}},type:"object"},"cl.ViewDetailsCommandEnded":{$schema:"http://json-schema.org/draft-07/schema#",title:"ViewDetailsCommandEnded",description:"Migrated from CL event type: **SessionEnded**\n\nCategory: Context\n\nCriticality Level: L3\n\n[View CL documentation](https://manuals.netflix.net/view/cltypes/mkdocs/master/classes/cl.sessionended.html)\n\nEnding event for: ViewDetailsCommand (merged with SessionEnded)",properties:{command:{description:"Command type name for Command-type events (e.g., PlayCommand)",type:"string"},connectionType:{description:"Network connection type (e.g., WifiConnection, MobileConnection, WiredConnection)",type:"string"},genreId:{description:"Genre ID with 3-level fallback: payload.trackingInfo → Focus.trackingInfo → NavigationLevel.trackingInfo","ntl-type":"int64",type:"integer"},lolomoId:{description:"Lolomo ID for presentation context",type:"string"},navigationLevel:{description:"Navigation level from session context",type:"string"},uiLocale:{description:"Application UI locale/language setting (e.g., en-US, es-ES)",type:"string"}},type:"object"},"netflix.AltCastImpression":{$schema:"http://json-schema.org/draft-07/schema#",title:"AltCastImpression",description:"### Use\nTracks exposure to altcasts to see when a member is exposed to the feature and could select one for playback.\n\n### Trigger\nWhen a member opens or enters one of the entry points with an altcast present. Provides details about the context of the impression, as well as the default selection (focus) the member begins with.",type:"object",properties:{altCastImpressionToken:{type:"string",description:"Unique identifier minted client-side when an altcast is presented to the member. Used to track actions within a funnel. Recycled when a member dismisses a surface with altcasts exposed. While this shouldn’t happen, if the field is empty, the event payload will have a null value for this field. "},altCastId:{type:"integer","ntl-type":"int64",description:"Unique identifier for the altcast. See the [Altcast data model](https://docs.google.com/document/d/1xTovd43H_SRp_8MAjQlG8XukruwV6Hqkfro-PJy4M-Y/edit?tab=t.0#heading=h.55l7l9nd33nz) spec for additional information."},platform:{type:"string",enum:["tv","iOS","android","web","tvOS"],"ntl-enum-descriptions":{tv:"TV device (NRDP)",iOS:"iOS mobile device",android:"Android mobile device",web:"Web device",tvOS:"tvOS device (not currently in use, but added for future use cases)"},description:"Platform on which the member was presented with an altcast."},entryPoint:{type:"string",enum:["details_page","legacy_details_page","magic_drawer","player"],"ntl-enum-descriptions":{details_page:"New Details Page from 2026 redesign",legacy_details_page:"Legacy Details Page for devices that don't support redesign",magic_drawer:"Magic Drawer shown during playback",player:"Embedded directly in player controls"},description:"Point in the UI where the altcast was presented to the member."},lifecycle:{type:"string",enum:["pre_launch","waiting_room","live","dvr","svod"],"ntl-enum-descriptions":{pre_launch:'Well before the event launched ("coming soon" state or similar)',waiting_room:"In the waiting room leading up to event launch",live:"Event was live",dvr:"Event had ended but is not yet transitioned to SVOD",svod:"Event has transitioned to SVOD (generally several days after live event ended)"},description:"Lifecycle of the altcast event when it was presented to a member. "},position:{type:"integer","ntl-type":"int32",minimum:-0x80000000,maximum:0x7fffffff,description:"Position in the row (or column for legacy Details Page). First position is 1, incrementing up to the last element. Default option is inferred from position = 1."}}},"netflix.AltCastInteraction":{$schema:"http://json-schema.org/draft-07/schema#",title:"AltCastInteraction",description:"### Use\nTracks when a member is interacting with altcasts, including hovering (focus) and selection. Used to measure funnel actions after exposure.\n\n### Trigger\nWhen a member makes an interaction with an altcast element in the UI.",type:"object",properties:{altCastImpressionToken:{type:"string",description:"Unique identifier minted client-side when an altcast is presented to the member. Used to track actions within a funnel. Recycled when a member dismisses a surface with altcasts exposed. While this shouldn’t happen, if the field is empty, the event payload will have a null value for this field. "},altCastId:{type:"integer","ntl-type":"int64",description:"Unique identifier for the altcast. See the [Altcast data model](https://docs.google.com/document/d/1xTovd43H_SRp_8MAjQlG8XukruwV6Hqkfro-PJy4M-Y/edit?tab=t.0#heading=h.55l7l9nd33nz) spec for additional information."},platform:{type:"string",enum:["tv","iOS","android","web","tvOS"],"ntl-enum-descriptions":{tv:"TV device (NRDP)",iOS:"iOS mobile device",android:"Android mobile device",web:"Web device",tvOS:"tvOS device (not currently in use, but added for future use cases)"},description:"Platform on which the member was presented with an altcast."},lifecycle:{type:"string",enum:["pre_launch","waiting_room","live","dvr","svod"],"ntl-enum-descriptions":{pre_launch:'Well before the event launched ("coming soon" state or similar)',waiting_room:"In the waiting room leading up to event launch",live:"Event was live",dvr:"Event had ended but is not yet transitioned to SVOD",svod:"Event has transitioned to SVOD (generally several days after live event ended)"},description:"Lifecycle of the altcast event when it was presented to a member. "},interactionType:{type:"string",enum:["focus","select"],"ntl-enum-descriptions":{focus:"Focused on a specific altcast",select:"Selected a specific altcast for playback"},description:"Type of interaction the member made with an altcast in the UI."},position:{type:"integer","ntl-type":"int32",minimum:-0x80000000,maximum:0x7fffffff,description:"Position in the row (or column for legacy Details Page). First position is 1, incrementing up to the last element. Default option is inferred from position = 1."}},required:["interactionType"]},"netflix.AvailabilityEvidenceShown":{$schema:"http://json-schema.org/draft-07/schema#",title:"AvailabilityEvidenceShown",description:"Live Team and Availability Evidence stakeholders want to monitor Availability Evidence logs, similar to how live/non-live callouts are logged and monitored. \nhttps://docs.google.com/document/d/1iSSlyBWJcm0oSp8Qo9PWhY-N5L_BVZhV0WnS-F_PKpQ/edit?tab=t.0\n",type:"object",properties:{availabilityEvidenceKey:{type:"string",description:"Evidence key for the availability evidence. Example: live_ave.live_one_time.live_within_month"},requestId:{type:"string"},trackId:{type:"number","ntl-type":"float32",minimum:-34028234663852886e22,maximum:34028234663852886e22},unifiedEntityId:{type:"string"}},required:["availabilityEvidenceKey","requestId","trackId","unifiedEntityId"]},"netflix.ClcsOnChange":{$schema:"http://json-schema.org/draft-07/schema#",title:"ClcsOnChange",description:"a CLCS field value was changed",type:"object",properties:{requestId:{type:"string"},screenName:{type:"string"},clcsRenditionId:{type:"string"},clcsSessionId:{type:"string"},screenVariantName:{type:"string"},abAllocations:{type:"string"},targetField:{type:"string"},funnelName:{type:"string"}},required:["requestId","screenName","clcsRenditionId","clcsSessionId","targetField","funnelName"]},"netflix.ClcsOnComponentVisible":{$schema:"http://json-schema.org/draft-07/schema#",title:"ClcsOnComponentVisible",description:"",type:"object",properties:{requestId:{type:"string"},screenName:{type:"string"},clcsRenditionId:{type:"string"},clcsSessionId:{type:"string"},screenVariantName:{type:"string"},abAllocations:{type:"string"},targetComponent:{type:"string"},funnelName:{type:"string"}},required:["requestId","screenName","clcsRenditionId","clcsSessionId","targetComponent","funnelName"]},"netflix.ClcsOnComponentVisibleEnd":{$schema:"http://json-schema.org/draft-07/schema#",title:"ClcsOnComponentVisibleEnd",description:"",type:"object",properties:{requestId:{type:"string"},screenName:{type:"string"},clcsRenditionId:{type:"string"},clcsSessionId:{type:"string"},screenVariantName:{type:"string"},abAllocations:{type:"string"},targetComponent:{type:"string"},funnelName:{type:"string"}},required:["requestId","screenName","clcsRenditionId","clcsSessionId","targetComponent","funnelName"]},"netflix.ClcsOnCustomEvent":{$schema:"http://json-schema.org/draft-07/schema#",title:"ClcsOnCustomEvent",description:"a CLCS client-side error occurred",type:"object",properties:{requestId:{type:"string"},screenName:{type:"string"},clcsRenditionId:{type:"string"},clcsSessionId:{type:"string"},screenVariantName:{type:"string"},abAllocations:{type:"string"},name:{type:"string"},payload:{type:"string"},funnelName:{type:"string"}},required:["requestId","screenName","clcsRenditionId","clcsSessionId","name","payload","funnelName"]},"netflix.ClcsOnError":{$schema:"http://json-schema.org/draft-07/schema#",title:"ClcsOnError",description:"a CLCS client-side error occurred",type:"object",properties:{requestId:{type:"string"},screenName:{type:"string"},clcsRenditionId:{type:"string"},clcsSessionId:{type:"string"},screenVariantName:{type:"string"},abAllocations:{type:"string"},errorCode:{type:"string"},errorMessage:{type:"string"},funnelName:{type:"string"}},required:["requestId","screenName","clcsRenditionId","clcsSessionId","errorCode","errorMessage","funnelName"]},"netflix.ClcsOnPress":{$schema:"http://json-schema.org/draft-07/schema#",title:"ClcsOnPress",description:"a CLCS pressable component was pressed by the user",type:"object",properties:{requestId:{type:"string"},screenName:{type:"string"},clcsRenditionId:{type:"string"},clcsSessionId:{type:"string"},screenVariantName:{type:"string"},abAllocations:{type:"string"},targetComponent:{type:"string"},funnelName:{type:"string"}},required:["requestId","screenName","clcsRenditionId","clcsSessionId","targetComponent","funnelName"]},"netflix.ClcsOnScreenRender":{$schema:"http://json-schema.org/draft-07/schema#",title:"ClcsOnScreenRender",description:"a clcs screen was rendered",type:"object",properties:{requestId:{type:"string"},screenName:{type:"string"},clcsRenditionId:{type:"string"},clcsSessionId:{type:"string"},screenVariantName:{type:"string"},abAllocations:{type:"string"},funnelName:{type:"string"}},required:["requestId","screenName","clcsRenditionId","clcsSessionId","funnelName"]},"netflix.CommerceOnPageView":{$schema:"http://json-schema.org/draft-07/schema#",title:"CommerceOnPageView",description:"Event fired when a page is rendered/viewed by the member. This event is meant to be used for non CLCS based data.",type:"object",properties:{url:{type:"string",description:"Fully qualified URL of the page that was rendered/ viewed"},payload:{type:"object",additionalProperties:{type:"string"},description:"Generic string payload map for scalable use"}},required:["url","payload"],additionalProperties:!1},"netflix.CommerceOnPress":{$schema:"http://json-schema.org/draft-07/schema#",title:"CommerceOnPress",description:"Event fired when a member presses an interactive UI element (button, row, link). This event is meant to be used for non CLCS based data.",type:"object",properties:{url:{type:"string",description:"Fully qualified URL of the page on which the press occurred"},targetElement:{type:"string",description:"Identifier of the UI element that was pressed (e.g. InvoiceExpandableRow, InvoiceLink)"},payload:{type:"object",additionalProperties:{type:"string"},description:"Generic string payload map for scalable use. Keys are context specific to the pressed element (e.g. an invoice identifier when the target element is an invoice row or link)"}},required:["url","targetElement","payload"],additionalProperties:!1},"netflix.DeliveryTestNtl":{$schema:"https://json-schema.org/draft/2020-12/schema",title:"DeliveryTestNtl",description:"Used to compare delivery capability of the CL logger and NTL logger used by client applications. This is the NTL version of that event.\n\nEach client should determine when the app should log this event. It should be neither too frequent (like Presented events) nor too infrequent. One suggestion is to log it whenever a DP is shown.",ntl:{clientBehaviorConfig:{canBatch:!0,requiresEnhancedSecurity:!1}},type:"object",properties:{willItBlend:{type:"boolean"},stringMap:{type:"object",additionalProperties:{type:"string"}}}},"netflix.FaqAccordionToggled":{$schema:"http://json-schema.org/draft-07/schema#",title:"FaqAccordionToggled",description:"",type:"object",properties:{viewName:{type:"string"},faqItemId:{type:"string"},action:{type:"string"}},required:["viewName","faqItemId","action"]},"netflix.HandledError":{$schema:"http://json-schema.org/draft-07/schema#",title:"HandledError",description:"Data about a handled error. Handled errors capture failures that have been accounted for. The location where the error is handled is already known, so there is no need for a call stack.\n\nThis is a replacement for one of the use cases of the CL ExceptionOccurred event.\nFor more details, see the [NTL: Events for Debugging](https://docs.google.com/document/d/1oqQr43_EEGYhDnrNPx629S6n7-y6h9iBmbKclC-kI8I/edit?tab=t.0) document.",type:"object",properties:{name:{description:"Name of the handled error.",type:"string"},message:{description:"A message describing the error.",type:"string"},location:{description:"The location where the error is handled.",type:"string"},level:{description:"The level of user impact or disruption caused by this error.\n- **fatal**: App session has failed, and a reload is required.\n- **disruption**: The user's journey is interrupted or the user experience is affected, but the app session is still usable. A retry, if available/possible, is likely to resolve it. Error dialogs are considered disruptions. Another example would be if the Continue Watching row failed to load.\n- **other**: All other types of errors, including ones where the user's journey is not interrupted or where impact is not fully known. For example, an error that results in a failed Lolomo genre row.",type:"string",enum:["disruption","fatal","other"]},data:{description:"Any additional metadata that can aid in debugging the error.\n\nIdeally, this type could have been a `Map<String, String/Number/Integer/Boolean/Object>`, but the schema only supports `Map<String, String>`. So, convert the values to strings, or JSON strings to preserve the type.",type:"object",additionalProperties:{type:"string"}},cause:{description:"The causal chain for the error. This can be the errors leading up to the handled error. Use the JSON string format for each individual array item.",type:"array",items:{type:"string"}}},required:["name"]},"netflix.HandledException":{$schema:"https://json-schema.org/draft/2020-12/schema",title:"HandledException",description:"Data about a handled exception. Handled exceptions capture unexpected failures in the app, where the call stack and/or component stack are vital for troubleshooting.\n\nThis is a replacement for one of the use cases of the CL ExceptionOccurred event.\nFor more details, see the [NTL: Events for Debugging](https://docs.google.com/document/d/1oqQr43_EEGYhDnrNPx629S6n7-y6h9iBmbKclC-kI8I/edit?tab=t.0) document.",type:"object",properties:{name:{description:"A name for the handled exception.",type:"string"},message:{description:"A message describing the error.",type:"string"},callStack:{description:"The call stack to help identify where the exception was thrown from.",type:"string"},componentStack:{description:"The component stack to help identify which UI component the exception occurred in.",type:"string"},level:{description:"The level of user impact or disruption caused by this exception.\n- **fatal**: App session has failed, and a reload is required.\n- **disruption**: The user's journey is interrupted or the user experience is affected, but the app session is still usable. A retry, if available/possible, is likely to resolve it. Error dialogs are considered disruptions. Another example would be an exception in the search page that results in a failure to load results.\n- **other**: All other types of errors, including ones where the user's journey is not interrupted or where impact is not fully known. For example, an exception that prevents an animation from running.",type:"string",enum:["disruption","fatal","other"]},data:{description:"Any additional metadata that can aid in debugging the exception.\n\nIdeally, this type could have been a `Map<String, String/Number/Integer/Boolean/Object>`, but the schema only supports `Map<String, String>`. So, convert the values to strings, or JSON strings to preserve the type.",type:"object",additionalProperties:{type:"string"}},cause:{description:"The causal chain for the error. This can be the errors leading up to the handled error. Use the JSON string format for each individual array item.",type:"array",items:{type:"string"}}},required:["name","callStack"]},"netflix.HendrixFieldAccess":{$schema:"http://json-schema.org/draft-07/schema#",title:"HendrixFieldAccess",description:"Represents a field access event for Hendrix/Woodstock fields.\n \nThis event is logged when a Hendrix field value is actually accessed (exposure)",type:"object",properties:{ruleSetName:{type:"string",description:"Name of RuleSet, for ABlaze Properties this is the fully-qualified name, e.g. (com.netflix.properties.foo)"},fieldName:{type:"string",description:"The specific field name within the ruleset."},ruleSetVersion:{type:"string",description:"Version identifier for the ruleset at the time of evaluation."},source:{type:"string",enum:["live","fallback","override"],"ntl-enum-descriptions":{live:"Value retrieved from Hendrix/Woodstock in real-time",fallback:"Used hardcoded fallback (Woodstock unavailable or kill switch active)",override:"Value was overridden via dev tools or URL params (DEV ONLY)"},description:"Indicates where the property value was sourced from"}},required:["ruleSetName","fieldName","ruleSetVersion"]},"netflix.MerchableEntityClicked":{$schema:"http://json-schema.org/draft-07/schema#",title:"MerchableEntityClicked",description:"Indicates the user clicked or tapped or activated on a merchable entity like a BoxArt, this may or may not trigger subsequent Actions.",type:"object",properties:{view:{description:"Name of the engaged view if any",type:"string"},trackingInfo:{description:"tracking information",type:"string"}},required:["view","trackingInfo"]},"netflix.Navigate":{$schema:"http://json-schema.org/draft-07/schema#",title:"Navigate",description:'Indicates that the user-interface is moving from one logical navigation "location" (e.g., page, screen, area) to another, "pushing" or "popping" location(s) against the navigation "stack".\n\nNavigate does not appear during the initial application bootstrap. It only appears in response to user actions after the app has loaded.\n\nExisting Use Cases\n2024-05-17 - Navigate and RenderNavigationLevel are the pair of events that define the start and the end of Canvas TTR, i.e. Time to Render when navigating within the app. To learn more about App QoE metrics see here\n',type:"object",properties:{command:{description:"Intent that resulted in logging this Action. This is a newly added field to support simplified schema. In order to be backwards compatible it is currently an optional value, however once all the logging follows simplified schema specification this will be made a required property\n",type:"string"},parentView:{description:"Name of the engaged parent view that triggered this action e.g. if more than one button with the same view name was clicked that triggered this action then the parent view name assigned to the button should be used here to distinguish between the two. However this field is optional and should only be used when the view by itself leads to ambiguity of where in the UI this action was triggered from.",type:"string"},view:{description:"Name of the engaged view that triggered this action e.g. if a button was clicked that triggered this action then the view name assigned to the button should be used here. However this field is optional, if this action was triggered without engaging any view (e.g. a button or a boxArt) then this field should not be set.",type:"string"},trackingInfo:{description:"Server-defined tracking information, if applicable.",type:"string"}},required:[]},"netflix.TestEventSecure":{$schema:"http://json-schema.org/draft-07/schema#",title:"TestEventSecure",description:"",type:"object",properties:{useTLS:{type:"boolean"},deviceId:{type:"string"},browserName:{type:"string"},browserVersion:{type:"string"}},required:["useTLS","deviceId","browserName","browserVe