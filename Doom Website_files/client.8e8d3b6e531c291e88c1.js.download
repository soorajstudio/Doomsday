  ...GamesHeroContentFragment\n        title\n        heroImageSmall: artwork(\n            params: {\n                format: WEBP\n                artworkType: BILLBOARD\n                dimension: { width: 960 }\n                features: {\n                    nonMemberBranding: true\n                    fallbackStrategy: STORY_ART\n                }\n            }\n        ) {\n            url\n        }\n        heroImageMedium: artwork(\n            params: {\n                format: WEBP\n                artworkType: BILLBOARD\n                dimension: { width: 1280 }\n                features: {\n                    nonMemberBranding: true\n                    fallbackStrategy: STORY_ART\n                }\n            }\n        ) {\n            url\n        }\n        heroImageLarge: artwork(\n            params: {\n                format: WEBP\n                artworkType: BILLBOARD\n                dimension: { width: 1920 }\n                features: {\n                    nonMemberBranding: true\n                    fallbackStrategy: STORY_ART\n                }\n            }\n        ) {\n            url\n        }\n\n        # promoVideo is the reliable source for the hero trailer video.\n        # supplementalVideosList was previously used but returns empty for\n        # mobile games, while promoVideo works for both mobile and cloud.\n        # videoId and __typename at the video level are required by Apollo\n        # cache normalization (keyFields).\n        promoVideo(context: { uiContext: BROWSE, supportsPlaygraph: true }) {\n            id\n            video {\n                __typename\n                videoId\n                ... on Supplemental {\n                    title\n                    videoId\n                    ...GamesBillboardVideoFragment\n                }\n            }\n        }\n    }\n":r.GamesLodpHeroFragmentDoc,"\n    fragment GamesHeroContentFragment on Game {\n        gameId\n        unifiedEntityId\n        __typename\n        title\n        gameStudioImage: artwork(\n            params: {\n                artworkType: BRAND_LOGO_CROPPED\n                dimension: { height: 48 }\n                features: { tone: LIGHT, nonMemberBranding: true }\n            }\n        ) {\n            url\n        }\n        iconImage: artwork(\n            params: {\n                format: WEBP\n                artworkType: APP_ICON\n                dimension: { width: 200, height: 200 }\n                features: {\n                    boxartForceUnbranded: true\n                    performNewContentCheck: false\n                    nonMemberBranding: true\n                }\n            }\n        ) {\n            url\n        }\n        cloudGameTitleWithLogo: artwork(\n            params: {\n                artworkType: LOGO_BRANDED_STACKED\n                format: WEBP\n                features: {\n                    brandLogoAlign: CENTER\n                    nonMemberBranding: true\n                    brandPadGravity: CENTER\n                }\n            }\n        ) {\n            url\n        }\n        lodpTaglineMessage: taglineMessage(\n            taglineRequest: { typedUiContext: LOGGED_OUT_DP }\n        ) {\n            tagline\n        }\n    }\n":r.GamesHeroContentFragmentFragmentDoc,"\n    fragment GamesAudioSubtitlesFragment on Game {\n        gameId\n        supportedLanguages\n    }\n":r.GamesAudioSubtitlesFragmentFragmentDoc,"\n    fragment GamesAvailableOnFragment on Game {\n        gameId\n        deviceCategories\n    }\n":r.GamesAvailableOnFragmentFragmentDoc,"\n    fragment GamesCompatibilityFragment on Game {\n        gameId\n        deviceCompatibility\n    }\n":r.GamesCompatibilityFragmentFragmentDoc,"\n    fragment GamesControllerSupportFragment on Game {\n        gameId\n        features {\n            controllerInfo\n            hasControllerSupport\n        }\n    }\n":r.GamesControllerSupportFragmentFragmentDoc,"\n    fragment GamesDurationFragment on Game {\n        gameId\n        contentMetadata {\n            duration {\n                label\n            }\n        }\n    }\n":r.GamesDurationFragmentFragmentDoc,"\n    fragment GamesContextualEvidenceFragment on Game {\n        gameId\n        features {\n            modes\n        }\n    }\n":r.GamesContextualEvidenceFragmentFragmentDoc,"\n    fragment GamesGenresFragment on Game {\n        gameId\n        genres {\n            edges {\n                node {\n                    genreId\n                    name\n                }\n            }\n        }\n    }\n":r.GamesGenresFragmentFragmentDoc,"\n    fragment GamesMaturityRatingFragment on Game {\n        gameId\n        contentAdvisory {\n            i18nReasonsText\n            maturityDescription\n        }\n    }\n":r.GamesMaturityRatingFragmentFragmentDoc,"\n    fragment GamesMoreDetailsFragment on Game {\n        gameId\n        ...GamesGenresFragment\n        ...GamesPersonsFragment\n        ...GamesContextualEvidenceFragment\n        ...GamesPlayersFragment\n        ...GamesDurationFragment\n        ...GamesAudioSubtitlesFragment\n        ...GamesRequiresInternetFragment\n        ...GamesReleaseYearFragment\n        ...GamesMaturityRatingFragment\n        ...GamesCompatibilityFragment\n        ...GamesControllerSupportFragment\n        ...GamesAvailableOnFragment\n    }\n":r.GamesMoreDetailsFragmentFragmentDoc,"\n    fragment GamesPersonsFragment on Game {\n        gameId\n        developer {\n            name\n        }\n    }\n":r.GamesPersonsFragmentFragmentDoc,"\n    fragment GamesPlayersFragment on Game {\n        gameId\n        features {\n            maximumPlayers\n            minimumPlayers\n        }\n    }\n":r.GamesPlayersFragmentFragmentDoc,"\n    fragment GamesReleaseYearFragment on Game {\n        gameId\n        releaseYear\n    }\n":r.GamesReleaseYearFragmentFragmentDoc,"\n    fragment GamesRequiresInternetFragment on Game {\n        gameId\n        features {\n            requiresConnectivity\n        }\n    }\n":r.GamesRequiresInternetFragmentFragmentDoc,"\n    fragment GamesSEOMetadataFragment on Game {\n        gameId\n        title\n        contextualSynopsis(context: { uiContext: ODP }) {\n            evidenceKey\n            text\n        }\n        iosInstallation {\n            appStoreId\n        }\n        ogImageSdp: artwork(\n            params: {\n                format: JPG\n                artworkType: GAME_OPENGRAPH_BOXART_HORIZONTAL\n                dimension: { width: 1200 }\n                features: {\n                    nonMemberBranding: true\n                    suppressTop10Badge: true\n                    performNewContentCheck: false\n                    enableLockBadgeChecks: false\n                }\n            }\n        ) {\n            url\n            height\n            width\n        }\n    }\n":r.GamesSEOMetadataFragmentFragmentDoc,"\n    fragment LolomoEdges on LolomoRowListEdge {\n        index\n        node {\n            listId\n            title\n            ... on LolomoDefaultRow {\n                genreId\n                isAvailableToNonMembers\n            }\n            entitiesConnection(first: $titleCount) {\n                totalCount\n                pageInfo {\n                    hasNextPage\n                }\n                edges {\n                    unifiedEntity {\n                        unifiedEntityId\n                        ... on Genre {\n                            genreId\n                            title\n                        }\n                        ... on Show {\n                            videoId\n                            title\n                        }\n                        ... on Movie {\n                            videoId\n                            title\n                        }\n                    }\n                    artwork(\n                        params: {\n                            artworkType: BOXSHOT\n                            dimension: { width: 300 }\n                            format: PNG\n                            features: { nonMemberBranding: true }\n                        }\n                    ) {\n                        url\n                    }\n                }\n            }\n        }\n    }\n":r.LolomoEdgesFragmentDoc,"\n    fragment HeroCtaPlans on GrowthPlans {\n        plans {\n            planId\n            price {\n                priceInCents\n                priceFormatted\n            }\n        }\n    }\n":r.HeroCtaPlansFragmentDoc,"\n    fragment LocpBillboardFragment on UnifiedEntity {\n        ... on Genre {\n            genreId\n        }\n        largeBillboard: artwork(\n            params: {\n                artworkType: BILLBOARD\n                features: { nonMemberBranding: true }\n            }\n        ) {\n            url\n            available\n            focalPoint {\n                x\n                y\n            }\n        }\n        verticalBillboard: artwork(\n            params: {\n                artworkType: VERTICAL_BILLBOARD\n                features: { nonMemberBranding: true }\n            }\n        ) {\n            url\n            available\n            focalPoint {\n                x\n                y\n            }\n        }\n    }\n":r.LocpBillboardFragmentFragmentDoc,"\n    fragment CollectionRowFragment on LolomoRow {\n        title\n        ... on LolomoDefaultRow {\n            genreId\n            isAvailableToNonMembers\n        }\n        entitiesConnection {\n            edges {\n                unifiedEntity {\n                    unifiedEntityId\n                    ... on Genre {\n                        genreId\n                        title\n                    }\n                    ... on Show {\n                        videoId\n                        title\n                    }\n                    ... on Movie {\n                        videoId\n                        title\n                    }\n                }\n                artwork(\n                    params: {\n                        artworkType: BOXSHOT\n                        dimension: { width: 300 }\n                        format: PNG\n                        features: { nonMemberBranding: true }\n                    }\n                ) {\n                    url\n                }\n            }\n        }\n    }\n":r.CollectionRowFragmentFragmentDoc,'\n    query LocpHeroMetadataAndLolomo(\n        $categoryId: String!\n        $rowCount: Int!\n        $titleCount: Int!\n        $isModernizedSignup: Boolean!\n        $collectionId: ID!\n        $hasCollectionId: Boolean!\n        $isContentAddOn: Boolean!\n        $billboardEntityId: ID!\n    ) {\n        tallPanelCollage: growthCollage(collageType: WEB_TALL_PANEL)\n            @skip(if: $hasCollectionId)\n        tallPanelCollectionCollage: growthCollectionCollage(\n            collageType: WEB_TALL_PANEL\n            collectionId: $collectionId\n        ) @include(if: $hasCollectionId)\n        mlpBillboard: unifiedEntities(unifiedEntityIds: [$billboardEntityId])\n            @include(if: $isContentAddOn) {\n            ...LocpBillboardFragment\n        }\n        plans: growthPlans {\n            ...LodpHeroPlans\n            ...Plans\n        }\n        freeTrialPackages: growthSignupPackages\n            @include(if: $isModernizedSignup) {\n            packages {\n                ...LandingPageFreeTrialPackage\n            }\n        }\n        newLolomo(\n            context: {\n                mapAnnotations: {\n                    billboardUIClient: "web"\n                    cacheResponseEnabled: true\n                    categoryId: $categoryId\n                    clientAppCapability: {\n                        clientAppCanHandlePageVideoContainerEvidenceRow: true\n                    }\n                    gpsModel: "saget"\n                    nonMemberRequest: true\n                }\n                cxuiAnnotations: {\n                    supportedBillboardTypes: [GENRE, STANDARD]\n                    platform: "web"\n                    uiVersion: "1.0.0"\n                    supportedLolomoFeatures: ["billboard"]\n                }\n            }\n        ) {\n            lolomoId\n            title\n            rowsConnection(first: $rowCount) {\n                totalCount\n                edges {\n                    ...LolomoEdges\n                }\n            }\n        }\n    }\n':r.LocpHeroMetadataAndLolomoDocument,"\n    query LodpTitleAndPlansPageQuery(\n        $videoId: Int!\n        $titleId: ID!\n        $opaqueImageFormat: ArtworkFormat!\n        $transparentImageFormat: ArtworkFormat!\n        $thumbnailVideoId: Int!\n        $hasValidThumbnailVideoId: Boolean!\n        $useBakedInPlayThumbnail: Boolean!\n        $useFromWatchSupplements: Boolean!\n        $isModernizedSignup: Boolean!\n    ) {\n        trifectaRows: growthVideoCollections(\n            collectionsInput: {\n                collectionInputs: [{ collectionType: TRENDING_NOW, limit: 10 }]\n            }\n        ) {\n            __typename\n            collections {\n                ...TitleRowFragment\n            }\n        }\n        videos(videoIds: [$videoId]) {\n            # __typename and videoId is required for the generated queries to work.\n            __typename\n            videoId\n            title\n            ...NMTitleHeadFragment\n            ...LodpTrailers\n            # MoreDetailsFragment is globally available via the generated queries harness in Shakti and is defined in\n            # MoreDetails.tsx\n            ...MoreDetailsFragment\n            ...LodpHero\n            ...MoreLikeThisFragment\n            ...LodpPageBackgroundFragment\n            ...MetadataLodpFragment\n            ...EpisodesSectionFragment\n            ...LiveTitleFragment\n            ...LiveTaglineMessagesFragment\n            ...ThumbnailClips\n            ...BakedInPlayArtworkFragment @include(if: $useBakedInPlayThumbnail)\n        }\n        customThumbnail: videos(videoIds: [$thumbnailVideoId])\n            @include(if: $hasValidThumbnailVideoId) {\n            __typename\n            videoId\n            ...Boxshot600Fragment\n            ...ShareThumbnailArtworkFragment\n                @include(if: $useFromWatchSupplements)\n            ... on Supplemental @include(if: $useFromWatchSupplements) {\n                ...BillboardVideoFragment\n            }\n        }\n        plans: growthPlans {\n            ...LodpHeroPlans\n            ...Plans\n        }\n        freeTrialPackages: growthSignupPackages\n            @include(if: $isModernizedSignup) {\n            packages {\n                ...LandingPageFreeTrialPackage\n            }\n        }\n        growthTitleAccess(titleId: $titleId) {\n            requiresContentAddOn\n            requiresAdFreePlan\n        }\n    }\n":r.LodpTitleAndPlansPageQueryDocument,"\n    fragment MoreLikeThisFragment on Video {\n        similarVideos {\n            videoId\n            ...TitleRowElementBoxshotFragment\n        }\n    }\n":r.MoreLikeThisFragmentFragmentDoc,"\n    fragment TitleRowFragment on GrowthVideoCollection {\n        videos {\n            __typename\n            videoId\n            ...TitleRowElementBoxshotFragment\n        }\n    }\n":r.TitleRowFragmentFragmentDoc,"\n    fragment EpisodeFragment on Episode {\n        videoId\n        title\n        runtimeSec\n        shortSynopsis\n        number\n        ...MerchStill300\n    }\n":r.EpisodeFragmentFragmentDoc,"\n    fragment EpisodesSectionFragment on Video {\n        ... on Show {\n            seasons {\n                pageInfo {\n                    hasNextPage\n                }\n                edges {\n                    node {\n                        videoId\n                        numberLabelV2(label: LONG)\n                        shortTitle\n                        title\n                        totalDisplayRuntimeInSec\n                        showMemberType\n                        episodes {\n                            pageInfo {\n                                hasNextPage\n                            }\n                            edges {\n                                node {\n                                    videoId\n                                    ...EpisodeFragment\n                                }\n                            }\n                        }\n                    }\n                }\n            }\n        }\n    }\n":r.EpisodesSectionFragmentFragmentDoc,"\n    fragment FacebookMetaFragment on Video {\n        videoId\n        title\n        shortSynopsis\n        ...UsePageTitleFragment\n        ...UseTitleHeadImageFragment\n        promoVideo(context: { uiContext: BILLBOARD }) {\n            video {\n                ... on Supplemental {\n                    ...SupplementalPlayableVideoFragment\n                }\n            }\n        }\n    }\n":r.FacebookMetaFragmentFragmentDoc,"\n    fragment TitleSchemaFragment on Video {\n        __typename\n        videoId\n        availabilityStartTime\n        shortSynopsis\n        title\n        actors: persons(roles: ACTOR) {\n            pageInfo {\n                hasNextPage\n            }\n            edges {\n                node {\n                    personId\n                    name\n                }\n            }\n        }\n        directors: persons(roles: DIRECTOR) {\n            pageInfo {\n                hasNextPage\n            }\n            edges {\n                node {\n                    personId\n                    name\n                }\n            }\n        }\n        creators: persons(roles: CREATOR) {\n            pageInfo {\n                hasNextPage\n            }\n            edges {\n                node {\n                    personId\n                    name\n                }\n            }\n        }\n        coreGenres {\n            pageInfo {\n                hasNextPage\n            }\n            edges {\n                node {\n                    genreId\n                    name\n                }\n            }\n        }\n        contentAdvisory {\n            certificationValue\n        }\n        ... on Show {\n            latestYear\n            seasons {\n                totalCount\n            }\n        }\n        ...UseTitleHeadImageFragment\n        promoVideo(context: { uiContext: BILLBOARD }) {\n            video {\n                videoId\n                shortSynopsis\n                title\n                availabilityStartTime\n                ...BillboardOrStoryArt1280\n                ... on Supplemental {\n                    displayRuntimeMs\n                    ...SupplementalPlayableVideoFragment\n                }\n            }\n        }\n    }\n":r.TitleSchemaFragmentFragmentDoc,"\n    fragment NMTitleHeadFragment on Video {\n        videoId\n        shortSynopsis\n        ...FacebookMetaFragment\n        ...TitleSchemaFragment\n        ...UsePageTitleFragment\n    }\n":r.NMTitleHeadFragmentFragmentDoc,"\n    fragment UsePageTitleFragment on Video {\n        videoId\n        title\n        hasOriginalTreatment\n    }\n":r.UsePageTitleFragmentFragmentDoc,"\n    fragment UseTitleHeadImageFragment on Video {\n        videoId\n        ...BillboardOrStoryArt1280\n    }\n":r.UseTitleHeadImageFragmentFragmentDoc,"\n    fragment BillboardVideoFragment on Supplemental {\n        videoId\n        __typename\n        ...SupplementalPlayableVideoFragment\n    }\n":r.BillboardVideoFragmentFragmentDoc,"\n    fragment LodpHero on Video {\n        videoId\n        __typename\n        ...LodpHeroPromoFragment\n        ...HeroContentFragment\n        ...LodpHeroImages\n        ...LodpShareTaglineFragment\n    }\n":r.LodpHeroFragmentDoc,"\n    fragment LodpShareTaglineFragment on Video {\n        videoId\n        shareTaglineMessages: taglineMessages(\n            taglineRequest: { typedUiContext: ODP }\n        ) {\n            tagline\n            typedClassification\n        }\n    }\n":r.LodpShareTaglineFragmentFragmentDoc,"\n    fragment LodpHeroPromoFragment on Video {\n        __typename\n        promoVideo(context: { uiContext: BILLBOARD }) {\n            __typename\n            id\n            video {\n                __typename\n                videoId\n                ... on Supplemental {\n                    videoId\n                    ...HeroVideoModalFragment\n                    ...BillboardVideoFragment\n                }\n            }\n        }\n        ...LodpLiveTaglineMessagesFragment\n    }\n":r.LodpHeroPromoFragmentFragmentDoc,"\n    fragment LodpHeroPlans on GrowthPlans {\n        ...HeroCtaPlans\n    }\n":r.LodpHeroPlansFragmentDoc,"\n    fragment HeroContentFragment on Video {\n        videoId\n        ...HeroLogoFragment\n        ...LodpLiveTaglineMessagesFragment\n        ...LiveTitleFragment\n        ...LiveTaglineMessagesFragment\n    }\n":r.HeroContentFragmentFragmentDoc,"\n    fragment HeroLogoFragment on Video {\n        videoId\n        __typename\n        title\n        ...LogoHorizontalCropped350\n        ...BrandLogoCropped48h\n    }\n":r.HeroLogoFragmentFragmentDoc,"\n    fragment HeroVideoModalFragment on Supplemental {\n        videoId\n        title\n        ...SupplementalPlayableVideoFragment\n    }\n":r.HeroVideoModalFragmentFragmentDoc,"\n    fragment LodpHeroImages on Video {\n        videoId\n        ...EclipseBillboardRedux1920\n        ...EclipseBillboardRedux1280\n        ...BillboardOrStoryArt960\n    }\n":r.LodpHeroImagesFragmentDoc,"\n    fragment ContentWarningFragment on Video {\n        videoId\n        contentWarning {\n            message\n            url\n            urlSubstitutionString\n        }\n    }\n":r.ContentWarningFragmentFragmentDoc,"\n    fragment MetadataLodpFragment on Video {\n        videoId\n        ... on Show {\n            numSeasonsLabel\n        }\n        title\n        shortSynopsis\n        latestYear\n        primaryGenres {\n            pageInfo {\n                hasNextPage\n            }\n            edges {\n                node {\n                    name\n                    genreId\n                }\n            }\n        }\n        ...PersonsMetadataFragment\n        contentAdvisory {\n            certificationValue\n        }\n        ...ContentWarningFragment\n        ...LiveTaglineMessagesFragment\n        ...LodpLiveTaglineMessagesFragment\n    }\n":r.MetadataLodpFragmentFragmentDoc,"\n    fragment PersonsMetadataFragment on Video {\n        videoId\n        actors: persons(roles: ACTOR) {\n            pageInfo {\n                hasNextPage\n            }\n            edges {\n                node {\n                    __typename\n                    name\n                    personId\n                }\n            }\n        }\n        creators: persons(roles: CREATOR) {\n            pageInfo {\n                hasNextPage\n            }\n            edges {\n                node {\n                    __typename\n                    name\n                    personId\n                }\n            }\n        }\n    }\n":r.PersonsMetadataFragmentFragmentDoc,"\n    fragment AudioSubtitlesFragment on Video {\n        videoId\n        mediaTracks {\n            audioTracks {\n                language\n                __typename\n            }\n            subtitles {\n                language\n                __typename\n            }\n        }\n    }\n":r.AudioSubtitlesFragmentFragmentDoc,"\n    fragment ClassificationFragment on Video {\n        videoId\n        ...GenresFragment\n        isAvailableForDownload\n        ...TagEvidenceFragment\n        ...TudumLinkFragment\n    }\n":r.ClassificationFragmentFragmentDoc,"\n    fragment TagEvidenceFragment on Video {\n        videoId\n        tags {\n            id\n            displayName\n            isDisplayable\n        }\n    }\n":r.TagEvidenceFragmentFragmentDoc,"\n    fragment GenresFragment on Video {\n        videoId\n        genres {\n            pageInfo {\n                hasNextPage\n            }\n            edges {\n                node {\n                    title\n                    genreId\n                }\n            }\n        }\n    }\n":r.GenresFragmentFragmentDoc,"\n    fragment MoreDetailsFragment on Video {\n        videoId\n        ...ClassificationFragment\n        ...PersonsFragment\n        ...AudioSubtitlesFragment\n    }\n":r.MoreDetailsFragmentFragmentDoc,"\n    fragment PersonsFragment on Video {\n        videoId\n        actors: persons(roles: ACTOR) {\n            pageInfo {\n                hasNextPage\n            }\n            edges {\n                node {\n                    __typename\n                    name\n                    personId\n                }\n            }\n        }\n        creators: persons(roles: CREATOR) {\n            pageInfo {\n                hasNextPage\n            }\n            edges {\n                node {\n                    __typename\n                    name\n                    personId\n                }\n            }\n        }\n    }\n":r.PersonsFragmentFragmentDoc,"\n    fragment TudumLinkFragment on Video {\n        videoId\n        title\n        ... on Show {\n            tudumTitle {\n                slug\n            }\n        }\n        ... on Movie {\n            tudumTitle {\n                slug\n            }\n        }\n    }\n":r.TudumLinkFragmentFragmentDoc,"\n    fragment LodpPageBackgroundFragment on Video {\n        videoId\n        __typename\n        ...LodpHeroImages\n        ...LodpHeroPromoFragment\n    }\n":r.LodpPageBackgroundFragmentFragmentDoc,"\n    fragment Plans on GrowthPlans {\n        plans {\n            planId\n            name\n            price {\n                priceFormatted\n                priceTier\n            }\n            tag\n            attributes {\n                videoQuality\n                audioQuality\n                hasAds\n            }\n        }\n    }\n":r.PlansFragmentDoc,"\n    fragment LodpTrailersData on Supplemental {\n        videoId\n        title\n        runtimeSec\n        type\n        artwork(\n            params: {\n                format: JPG\n                artworkType: MERCH_STILL\n                features: { nonMemberBranding: true }\n            }\n        ) {\n            url\n        }\n        playableVideo(\n            request: { encodingProfiles: NODRM_H264BPL30_HEAAC_MP4 }\n        ) {\n            url\n        }\n    }\n":r.LodpTrailersDataFragmentDoc,"\n    fragment ThumbnailClips on Video {\n        thumbnailClips: supplementalVideosList(uiContext: CLIPS) {\n            pageInfo {\n                hasNextPage\n            }\n            edges {\n                node {\n                    videoId\n                    title\n                }\n            }\n        }\n    }\n":r.ThumbnailClipsFragmentDoc,'\n    fragment LodpTrailers on Video {\n        videoId\n        trailers: supplementalVideosList(types: ["TRAILER", "TEASER_TRAILER"]) {\n            pageInfo {\n                hasNextPage\n            }\n            edges {\n                node {\n                    ...LodpTrailersData\n                }\n            }\n        }\n    }\n':r.LodpTrailersFragmentDoc,"\n    fragment LogoHorizontalCropped350 on Video {\n        videoId\n        logoStackCropped350: artwork(\n            params: {\n                artworkType: LOGO_HORIZONTAL_CROPPED\n                dimension: { width: 350 }\n                format: $transparentImageFormat\n                features: { nonMemberBranding: true }\n            }\n        ) {\n            ...Artwork\n        }\n    }\n":r.LogoHorizontalCropped350FragmentDoc,"\n    fragment MerchStill300 on Video {\n        videoId\n        merchStill300: artwork(\n            params: {\n                artworkType: MERCH_STILL\n                dimension: { width: 300 }\n                format: $transparentImageFormat\n                features: { nonMemberBranding: true }\n            }\n        ) {\n            ...Artwork\n        }\n    }\n":r.MerchStill300FragmentDoc,"\n    fragment BrandLogoCropped48h on Video {\n        videoId\n        brandLogoCropped48h: artwork(\n            params: {\n                artworkType: BRAND_LOGO_CROPPED\n                dimension: { height: 48 }\n                features: { tone: LIGHT, nonMemberBranding: true }\n                format: $transparentImageFormat\n            }\n        ) {\n            ...Artwork\n        }\n    }\n":r.BrandLogoCropped48hFragmentDoc,"\n    fragment BillboardOrStoryArt1920 on Video {\n        videoId\n        billboardOrStoryArt1920: artwork(\n            params: {\n                artworkType: BILLBOARD\n                dimension: { width: 1920 }\n                format: $opaqueImageFormat\n                features: {\n                    fallbackStrategy: STORY_ART\n                    nonMemberBranding: true\n                }\n            }\n        ) {\n            ...Artwork\n        }\n    }\n":r.BillboardOrStoryArt1920FragmentDoc,"\n    fragment BillboardOrStoryArt1280 on Video {\n        videoId\n        billboardOrStoryArt1280: artwork(\n            params: {\n                artworkType: BILLBOARD\n                dimension: { width: 1280 }\n                format: $opaqueImageFormat\n                features: {\n                    fallbackStrategy: STORY_ART\n                    nonMemberBranding: true\n                }\n            }\n        ) {\n            ...Artwork\n        }\n    }\n":r.BillboardOrStoryArt1280FragmentDoc,"\n    fragment BillboardOrStoryArt960 on Video {\n        videoId\n        billboardOrStoryArt960: artwork(\n            params: {\n                artworkType: BILLBOARD\n                dimension: { width: 960 }\n                format: $opaqueImageFormat\n                features: {\n                    fallbackStrategy: STORY_ART\n                    nonMemberBranding: true\n                }\n            }\n        ) {\n            ...Artwork\n        }\n    }\n":r.BillboardOrStoryArt960FragmentDoc,"\n    fragment EclipseBillboardRedux1280 on Video {\n        videoId\n        eclipseBillboardRedux1280: artwork(\n            params: {\n                artworkType: ECLIPSE_BILLBOARD_REDUX\n                dimension: { width: 1280 }\n                format: $opaqueImageFormat\n                features: { nonMemberBranding: true }\n            }\n        ) {\n            ...Artwork\n        }\n    }\n":r.EclipseBillboardRedux1280FragmentDoc,"\n    fragment EclipseBillboardRedux1920 on Video {\n        videoId\n        eclipseBillboardRedux1920: artwork(\n            params: {\n                artworkType: ECLIPSE_BILLBOARD_REDUX\n                dimension: { width: 1920 }\n                format: $opaqueImageFormat\n                features: { nonMemberBranding: true }\n            }\n        ) {\n            ...Artwork\n        }\n    }\n":r.EclipseBillboardRedux1920FragmentDoc,"\n    fragment Boxshot600Fragment on Video {\n        videoId\n        Boxshot600: artwork(\n            params: {\n                artworkType: ECLIPSE_BOXART_SMALL\n                dimension: { width: 600 }\n                format: $opaqueImageFormat\n                features: { nonMemberBranding: false }\n            }\n        ) {\n            ...Artwork\n        }\n    }\n":r.Boxshot600FragmentFragmentDoc,"\n    fragment BakedInPlayArtworkFragment on Video {\n        videoId\n        bakedInPlayArtwork: artwork(\n            params: {\n                artworkType: ECLIPSE_BOXART_BACKGROUND_PLAY_BUTTON\n                dimension: { width: 1280 }\n                format: $opaqueImageFormat\n                features: { nonMemberBranding: true }\n            }\n        ) {\n            ...Artwork\n        }\n    }\n":r.BakedInPlayArtworkFragmentFragmentDoc,"\n    fragment ShareThumbnailArtworkFragment on Video {\n        videoId\n        bakedInPlayArtwork: artwork(\n            params: {\n                artworkType: ECLIPSE_BOXART_BACKGROUND_PLAY_BUTTON\n                dimension: { width: 1280 }\n                format: $opaqueImageFormat\n                features: { nonMemberBranding: false }\n            }\n        ) {\n            ...Artwork\n        }\n    }\n":r.ShareThumbnailArtworkFragmentFragmentDoc,"\n    fragment LiveTitleFragment on Video {\n        videoId\n        __typename\n        ... on Show {\n            isAvailable\n            nextLiveEvent {\n                isSvodAvailable\n                timeWindow {\n                    startTimeMs\n                }\n            }\n        }\n        ... on Movie {\n            isAvailable\n            liveEvent {\n                isSvodAvailable\n                timeWindow {\n                    startTimeMs\n                }\n            }\n        }\n        ... on Episode {\n            isAvailable\n            liveEvent {\n                isSvodAvailable\n                timeWindow {\n                    startTimeMs\n                }\n            }\n        }\n    }\n":r.LiveTitleFragmentFragmentDoc,"\n    fragment LiveTaglineMessagesFragment on Video {\n        __typename\n        videoId\n        ... on Show {\n            allTaglineMessagesByEventState(\n                supportedCapabilities: { canHandleLiveEventState: false }\n                taglineRequest: {\n                    typedUiContext: EPISODE_LIST\n                    supportsMessageBadging: true\n                }\n            ) {\n                taglineMessages {\n                    tagline\n                    badgePrefix\n                }\n                state\n            }\n            nextEventWindow {\n                state(\n                    supportedCapabilities: { canHandleLiveEventState: true }\n                ) {\n                    eventType\n                    value {\n                        currentState\n                    }\n                    name\n                    parameters\n                }\n            }\n        }\n        ... on Movie {\n            allTaglineMessagesByEventState(\n                supportedCapabilities: { canHandleLiveEventState: false }\n                taglineRequest: {\n                    typedUiContext: BOB\n                    supportsMessageBadging: true\n                }\n            ) {\n                taglineMessages {\n                    tagline\n                    badgePrefix\n                }\n                state\n            }\n            eventWindow {\n                state(\n                    supportedCapabilities: { canHandleLiveEventState: true }\n                ) {\n                    value {\n                        currentState\n                    }\n                    name\n                    parameters\n                }\n            }\n        }\n        ... on Episode {\n            allTaglineMessagesByEventState(\n                supportedCapabilities: { canHandleLiveEventState: false }\n                taglineRequest: {\n                    typedUiContext: BOB\n                    supportsMessageBadging: true\n                }\n            ) {\n                taglineMessages {\n                    tagline\n                    badgePrefix\n                }\n                state\n            }\n            eventWindow {\n                state(\n                    supportedCapabilities: { canHandleLiveEventState: true }\n                ) {\n                    value {\n                        currentState\n                    }\n                    name\n                    parameters\n                }\n            }\n        }\n    }\n":r.LiveTaglineMessagesFragmentFragmentDoc,"\n    fragment LodpLiveTaglineMessagesFragment on Video {\n        videoId\n        __typename\n        taglineMessages(\n            taglineRequest: {\n                typedUiContext: LOGGED_OUT_DP\n                supportsMessageBadging: true\n            }\n        ) {\n            tagline\n            badgePrefix\n            renderCountdownTimer\n        }\n        ... on Show {\n            loggedOutTaglines: allTaglineMessagesByEventState(\n                supportedCapabilities: { canHandleLiveEventState: true }\n                taglineRequest: {\n                    typedUiContext: LOGGED_OUT_DP\n                    supportsMessageBadging: true\n                }\n            ) {\n                taglineMessages {\n                    tagline\n                    badgePrefix\n                }\n                state\n            }\n            nextEventWindow {\n                state(\n                    supportedCapabilities: { canHandleLiveEventState: true }\n                ) {\n                    value {\n                        currentState\n                    }\n                    name\n                    parameters\n                }\n            }\n        }\n        ... on Movie {\n            loggedOutTaglines: allTaglineMessagesByEventState(\n                supportedCapabilities: { canHandleLiveEventState: true }\n                taglineRequest: {\n                    typedUiContext: LOGGED_OUT_DP\n                    supportsMessageBadging: true\n                }\n            ) {\n                taglineMessages {\n                    tagline\n                    badgePrefix\n                }\n                state\n            }\n            eventWindow {\n                state(\n                    supportedCapabilities: { canHandleLiveEventState: true }\n                ) {\n                    value {\n                        currentState\n                    }\n                    name\n                    parameters\n                }\n            }\n        }\n        ... on Episode {\n            loggedOutTaglines: allTaglineMessagesByEventState(\n                supportedCapabilities: { canHandleLiveEventState: true }\n                taglineRequest: {\n                    typedUiContext: LOGGED_OUT_DP\n                    supportsMessageBadging: true\n                }\n            ) {\n                taglineMessages {\n                    tagline\n                    badgePrefix\n                }\n                state\n            }\n            eventWindow {\n                state(\n                    supportedCapabilities: { canHandleLiveEventState: true }\n                ) {\n                    value {\n                        currentState\n                    }\n                    name\n                    parameters\n                }\n            }\n        }\n    }\n":r.LodpLiveTaglineMessagesFragmentFragmentDoc,"\n    fragment FaqPlans on GrowthPlans {\n        plans {\n            price {\n                priceInCents\n                priceFormatted\n            }\n            attributes {\n                hasAds\n            }\n        }\n    }\n":r.FaqPlansFragmentDoc,"\n    query NmhpPageQuery(\n        $opaqueImageFormat: ArtworkFormat!\n        $transparentImageFormat: ArtworkFormat!\n        $shouldFetchTrending: Boolean!\n        $isModernizedSignup: Boolean!\n    ) {\n        trending: growthVideoCollections(\n            collectionsInput: {\n                collectionInputs: [{ collectionType: TRENDING_NOW, limit: 10 }]\n            }\n        ) @include(if: $shouldFetchTrending) {\n            __typename\n            collections {\n                ...TrendingSectionFragment\n            }\n        }\n        imageCollage: growthCollage(collageType: WEB)\n        plans: growthPlans {\n            ...HeroPlans\n            ...PromoBannerPlans\n            ...FaqPlans\n        }\n        freeTrialPackages: growthSignupPackages\n            @include(if: $isModernizedSignup) {\n            packages {\n                ...LandingPageFreeTrialPackage\n            }\n        }\n    }\n":r.NmhpPageQueryDocument,"\n    fragment HeroPlans on GrowthPlans {\n        plans {\n            price {\n             