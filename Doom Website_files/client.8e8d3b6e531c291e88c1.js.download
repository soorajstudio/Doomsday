rmat: WEBP\n                    artworkType: APP_ICON\n                    dimension: { width: 150, height: 150 }\n                    features: {\n                        boxartForceUnbranded: true\n                        performNewContentCheck: false\n                        nonMemberBranding: true\n                    }\n                }\n            ) {\n                url\n            }\n            pageBackgroundImage: artwork(\n                params: {\n                    format: WEBP\n                    artworkType: BILLBOARD\n                    features: { nonMemberBranding: true }\n                }\n            ) {\n                url\n            }\n        }\n        growthPlans {\n            plans {\n                planId\n                price {\n                    priceInCents\n                    priceFormatted\n                }\n            }\n        }\n    }\n":r.GameDetailsQueryDocument,"\n    fragment GamesDownloadFragment on Game {\n        gameId\n        unifiedEntityId\n        iosInstallation {\n            appStoreId\n        }\n        androidInstallation {\n            packageName\n        }\n    }\n":r.GamesDownloadFragmentFragmentDoc,"\n    fragment GamesGallery on Game {\n        gameId\n        title\n        unifiedEntityId\n        orientation\n        landscapeScreenshots: artworks(\n            params: {\n                format: WEBP\n                artworkType: GAME_ART_HORIZONTAL\n                dimension: { width: 500 }\n            }\n        ) {\n            key\n            url\n        }\n        portraitScreenshots: artworks(\n            params: {\n                format: WEBP\n                artworkType: GAME_ART_VERTICAL\n                dimension: { height: 500 }\n            }\n        ) {\n            key\n            url\n        }\n        trailers: supplementalVideosList(first: 6) {\n            edges {\n                node {\n                    videoId\n                    title\n              