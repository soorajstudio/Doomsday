 contentAdvisory {\n            certificationValue\n        }\n        coreGenres {\n            edges {\n                node {\n                    genreId\n                    name\n                }\n            }\n        }\n        ...Billboard960\n        ...LogoCropped400\n        ...Boxshot200NoTop10NoRecentlyAdded\n\n        # The title of shows are things like "Season 1" and we need the actual\n        # show title for the alt text of the show logo.\n        ... on Season {\n            parentShow {\n                videoId\n                title\n            }\n        }\n    }\n':r.TrendingTitleModalFragmentFragmentDoc,"\n    fragment TrendingTitleFragment on Video {\n        ... on Season {\n            parentShow {\n                videoId\n            }\n        }\n        videoId\n        title\n        ...Boxshot200NoTop10NoRecentlyAdded\n    }\n":r.TrendingTitleFragmentFragmentDoc,"\n    fragment TrendingSectionFragment on GrowthVideoCollection {\n        videos {\n            __typename\n            videoId\n            ...TrendingTitleFragment\n            ...TrendingTitleModalFragment\n        }\n    }\n":r.TrendingSectionFragmentFragmentDoc,"\n    fragment Boxshot300 on Video {\n        videoId\n        boxshot300: artwork(\n            params: {\n                artworkType: BOXSHOT\n                dimension: { width: 300 }\n                features: {\n                    suppressTop10Badge: true\n                    performNewContentCheck: false\n                    nonMemberBranding: true\n                }\n                format: $opaqueImageFormat\n            }\n        ) {\n            ...Artwork\n        }\n    }\n":r.Boxshot300FragmentDoc,"\n    fragment TitleRowElementBoxshotFragment on Video {\n        videoId\n        title\n        ...Boxshot300\n    }\n":r.TitleRowElementBoxshotFragmentFragmentDoc,"\n    fragment SupplementalPlayableVideoFragment on Supplemental {\n        videoId\n        playableVideo(\n            request: {\n                encodingProfiles: NODRM_H264MPL31_HEAAC_MP4\n                prefersNonLetterBoxedVideo: true\n            }\n        ) {\n            url\n        }\n    }\n":r.SupplementalPlayableVideoFragmentFragmentDoc,"\n    query OrderFinalSignupChargeDecline {\n        account {\n            signupChargeDeclineReason\n        }\n    }\n":r.OrderFinalSignupChargeDeclineDocument,"\n    mutation SecondaryLanguagesMutation(\n        $guid: ID!\n        $secondaryLanguages: [LanguageBCP47Code!]\n    ) {\n        editProfile(\n            input: { id: $guid, contentLanguages: $secondaryLanguages }\n        ) {\n            account {\n                profile(guid: $guid) {\n                    secondaryLanguages\n                }\n            }\n        }\n    }\n":r.SecondaryLanguagesMutationDocument,"\n    query OrderFinalAccountOwnerName {\n        growthAccount {\n            name {\n                firstName {\n                    ... on GrowthClearStringValue {\n                        value\n                    }\n                }\n            }\n        }\n    }\n":r.OrderFinalAccountOwnerNameDocument,"\n    mutation RecordOnrampImpression {\n        recordOnrampImpression {\n            success\n        }\n    }\n":r.RecordOnrampImpressionDocument,"\n    fragment SecondaryProfileDemoFragment on GrowthCollectEmailConsentInfo {\n        pipcConsentRequired\n        emailConsentLabelId\n        privacyStatementRequired\n        termsOfUseMinimumVerificationAge\n    }\n":r.SecondaryProfileDemoFragmentFragmentDoc,"\n    query SecondaryDemoCollectionPage($profileGuid: ID) {\n        currentProfile {\n            guid\n            name\n            isEligibleFor1PDataCollection\n        }\n        growthCollectEmailConsentInfo(\n            contextInput: {\n                growthInputNode: { inputUserJourneyNode: UPDATE_PROFILE_EMAIL }\n            }\n            collectEmailConsentInfoInput: {\n                collectEmailType: PROFILE_ADD_EMAIL\n                profileGuid: $profileGuid\n            }\n        ) {\n            ...SecondaryProfileDemoFragment\n        }\n    }\n":r.SecondaryDemoCollectionPageDocument,"\n    mutation GrowthCreateMfaChallenge(\n        $createMfaChallengeInput: GrowthCreateMfaChallengeInput!\n        $contextInput: GrowthContextInput!\n    ) {\n        growthCreateMfaChallenge(\n            createMfaChallengeInput: $createMfaChallengeInput\n            contextInput: $contextInput\n        ) {\n            ...GrowthMutationResponseFragment\n        }\n    }\n":r.GrowthCreateMfaChallengeDocument,"\n    fragment Artwork on Image {\n        key\n        url\n        width\n        height\n        available\n        status\n        focalPoint {\n            x\n            y\n        }\n    }\n":r.ArtworkFragmentDoc,"\n    fragment Bookmark on Viewable {\n        ... on Video {\n            videoId\n        }\n\n        runtimeSec\n        bookmark {\n            position\n        }\n    }\n":r.BookmarkFragmentDoc,"\n    fragment GrowthMutationResponseFragment on GrowthMutationResponse {\n        __typename\n        ... on GrowthNextNode {\n            userJourneyNodeName\n            treatment\n            intent {\n                value\n                category\n            }\n        }\n        ... on GrowthMutationError {\n            errorCode\n            errorType\n            errorMessage\n            debugInfo {\n                key\n                value\n            }\n            redirectNode {\n                userJourneyNodeName\n                treatment\n                intent {\n                    value\n                    category\n                }\n            }\n        }\n\n        ... on GrowthMutationTask {\n            id\n            pollingInterval\n        }\n    }\n":r.GrowthMutationResponseFragmentFragmentDoc,"\n    fragment LiveEventMetadata on LiveEvent {\n        availabilityStartTime\n        timeWindow {\n            # use availabilityStartTime instead of startTime here\n            endTime\n        }\n        event {\n            ... on Episode {\n                videoId\n                isAvailable\n            }\n\n            ... on Movie {\n                videoId\n                isAvailable\n            }\n\n            # LiveEventViewable's third implementer. No consumer reads a\n            # SportEvent-typed event yet, but leaving it unselected would make\n            # one silently resolve to an empty object.\n            ... on SportEvent {\n                videoId\n                unifiedEntityId\n                isAvailable\n            }\n        }\n    }\n":r.LiveEventMetadataFragmentDoc,"\n    fragment LiveVideo on Video {\n        videoId\n\n        ... on Show {\n            nextLiveEvent {\n                ...LiveEventMetadata\n            }\n        }\n\n        ... on LiveEventViewable {\n            liveEvent {\n                ...LiveEventMetadata\n            }\n        }\n    }\n":r.LiveVideoFragmentDoc,"\n    fragment LiveEventTaglines on Video {\n        videoId\n\n        ... on LiveEventInRealTimeWindow {\n            allTaglineMessagesByLiveState(\n                taglineRequest: {\n                    typedUiContext: $textEvidenceUiContext\n                    supportsMessageBadging: true\n                }\n            ) {\n                taglineMessages {\n                    tagline\n                    typedClassification\n                    badgeDate\n                    badgePrefix\n                }\n                state\n            }\n        }\n    }\n":r.LiveEventTaglinesFragmentDoc,"\n    fragment VideoPlaylist on Video {\n        videoId\n        unifiedEntityId\n\n        isPlayable\n        isAvailable\n        unplayableCauses\n\n        isInPlaylist\n        isInRemindMeList\n        isInRollingRemindersList\n        hasRecurringReleases\n        playlistActions\n\n        ...LiveVideo\n    }\n":r.VideoPlaylistFragmentDoc,"\n    fragment GamePlaylist on Game {\n        gameId\n        unifiedEntityId\n\n        isPlayable\n        isInPlaylist\n        isInRemindMeList\n        gamePlaylistActions: playlistActions\n    }\n":r.GamePlaylistFragmentDoc,"\n    mutation AddToPlaylist($entityId: ID!, $trackId: ID, $signature: String) {\n        addEntityToPlaylist(\n            input: {\n                entityId: $entityId\n                trackId: $trackId\n                signature: $signature\n            }\n        ) {\n            entity {\n                ... on Video {\n                    videoId\n                    unifiedEntityId\n                    title\n                    isInPlaylist\n                    isInRemindMeList\n                }\n                ... on Game {\n                    gameId\n                    gamePlaylistActions: playlistActions\n                    isInPlaylist\n                }\n            }\n        }\n    }\n":r.AddToPlaylistDocument,"\n    mutation RemoveFromPlaylist(\n        $entityId: ID!\n        $trackId: ID\n        $signature: String\n    ) {\n        removeEntityFromPlaylist(\n            input: {\n                entityId: $entityId\n                trackId: $trackId\n                signature: $signature\n            }\n        ) {\n            entity {\n                ... on Video {\n                    videoId\n                    unifiedEntityId\n                    title\n                    isInPlaylist\n                    isInRemindMeList\n                }\n                ... on Game {\n                    gameId\n                    gamePlaylistActions: playlistActions\n                    isInPlaylist\n                }\n            }\n        }\n    }\n":r.RemoveFromPlaylistDocument,"\n    mutation AddReminder($entityId: ID!, $signature: String, $trackId: ID) {\n        addUnifiedEntityToRemindMe(\n            input: {\n                unifiedEntityId: $entityId\n                signature: $signature\n                trackId: $trackId\n            }\n        ) {\n            ... on Video {\n                videoId\n                unifiedEntityId\n                playlistActions\n                isInPlaylist\n                isInRemindMeList\n            }\n            ... on Game {\n                gameId\n                gamePlaylistActions: playlistActions\n                isInPlaylist\n                isInRemindMeList\n            }\n        }\n    }\n":r.AddReminderDocument,"\n    mutation RemoveReminder($entityId: ID!, $signature: String, $trackId: ID) {\n        removeUnifiedEntityFromRemindMe(\n            input: {\n                unifiedEntityId: $entityId\n                signature: $signature\n                trackId: $trackId\n            }\n        ) {\n            ... on Video {\n                videoId\n                unifiedEntityId\n                playlistActions\n                isInPlaylist\n                isInRemindMeList\n            }\n            ... on Game {\n                gameId\n                gamePlaylistActions: playlistActions\n                isInPlaylist\n                isInRemindMeList\n            }\n        }\n    }\n":r.RemoveReminderDocument,"\n    mutation AddRollingReminders(\n        $entityId: ID!\n        $signature: String\n        $trackId: ID\n    ) {\n        addUnifiedEntityToRollingReminders(\n            input: {\n                unifiedEntityId: $entityId\n                signature: $signature\n                trackId: $trackId\n            }\n        ) {\n            ... on Video {\n                videoId\n                unifiedEntityId\n                playlistActions\n                isInPlaylist\n                isInRollingRemindersList\n                hasRecurringReleases\n            }\n        }\n    }\n":r.AddRollingRemindersDocument,"\n    mutation RemoveRollingReminders(\n        $entityId: ID!\n        $signature: String\n        $trackId: ID\n    ) {\n        removeUnifiedEntityFromRollingReminders(\n            input: {\n                unifiedEntityId: $entityId\n                signature: $signature\n                trackId: $trackId\n            }\n        ) {\n            ... on Video {\n                videoId\n                unifiedEntityId\n                playlistActions\n                isInPlaylist\n                isInRollingRemindersList\n                hasRecurringReleases\n            }\n        }\n    }\n":r.RemoveRollingRemindersDocument,"\n    fragment ResumableVideoCurrentStandalone on Video {\n        videoId\n        title\n    }\n":r.ResumableVideoCurrentStandaloneFragmentDoc,'\n    fragment ResumableVideoCurrentEpisode on Episode {\n        videoId\n\n        title\n        number\n        hideEpisodeNumbers: hasTitleBehavior(behavior: "hiddenEpisodeNumbers")\n        parentSeason {\n            videoId\n            number\n            title\n            numberLabel: numberLabelV2(label: ABBR)\n            hideEpisodeNumbers: hasTitleBehavior(\n                behavior: "hiddenEpisodeNumbers"\n            )\n        }\n    }\n':r.ResumableVideoCurrentEpisodeFragmentDoc,"\n    fragment ResumableVideo on Video {\n        videoId\n\n        ... on Movie {\n            ...ResumableVideoCurrentStandalone\n        }\n\n        ... on SportEvent {\n            unifiedEntityId\n            ...ResumableVideoCurrentStandalone\n        }\n\n        ... on Episode {\n            videoId\n            ...ResumableVideoCurrentEpisode\n        }\n\n        ... on Show {\n            currentEpisode {\n                videoId\n                ...ResumableVideoCurrentEpisode\n            }\n        }\n        ... on Season {\n            parentShow {\n                videoId\n                currentEpisode {\n                    ...ResumableVideoCurrentEpisode\n                }\n            }\n        }\n    }\n":r.ResumableVideoFragmentDoc,"\n    fragment TitleGroup on TitleGroup {\n        id\n        kind\n        title\n        siblings {\n            videoId\n        }\n    }\n":r.TitleGroupFragment