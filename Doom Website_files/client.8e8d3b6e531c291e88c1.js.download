V1jp0SIqJ9MKbXVsrU/edit?tab=t.tzqar06hkex0#heading=h.1w0yvf7sehqz) #### %minimum(0)%"},option:{type:"string",minLength:1,description:"%minLength(1)%"},rank:{type:"integer","ntl-type":"int64",minimum:0,description:"%minimum(0)%"},rankNum:{type:"integer","ntl-type":"int64",minimum:0,description:"%minimum(0)%"},referringGameTitleId:{type:"integer","ntl-type":"int64",description:'The "source" game title id of where the event originated. Used to track the source of the gameplay attempt, specifically for the case where a game is merched from a different game title.'},requestId:{type:"string",minLength:1,description:"%minLength(1)%"},row:{type:"integer","ntl-type":"int64",minimum:0,maximum:50,description:"%minimum(0)% %maximum(90)%"},rowNum:{type:"integer","ntl-type":"int64",minimum:0,maximum:50,description:"%minimum(0)% %maximum(90)%"},selectionType:{type:"string",enum:["focus","keydown","keyenter"]},sourceUuid:{type:"string",minLength:34,description:"The uuid of the source session or entity that led to the current one being tracked."},trackId:{type:"integer","ntl-type":"int64",minimum:1,description:"%minimum(1)%"},unifiedEntityId:{type:"string",format:"ueid",description:'%format("ueid")%'},videoId:{type:"integer","ntl-type":"int64",minimum:1,maximum:0x3b9ac9ff,description:"%minimum(1)% %maximum(999999999)%"}},description:"This interface points to a structured version of trackingInfo, use it whenever you want to validate the fields within this structure"},uiLocale:{type:"string",description:"Application UI locale/language setting (e.g., en-US, es-ES)"},userInput:{type:"string",description:"User input value (e.g., search text, slider value)"},view:{type:"string",description:"The presented view."},webpageUrl:{type:"string",description:"URL of the webpage where the event occurred"},playbackMode:{type:"string",enum:["linear","live","svod","unknown"],description:"Playback classification captured when this session starts. Because [[Presentation]] is a base session, this optional field is also available to all derived Presentation sessions; producers outside an approved playback contract leave it absent. The value remains immutable for the session's lifetime and terminal event. A missing value means the producer did not provide a classification; use [[PlaybackMode.unknown]] when classification is provided but unresolved."}},required:["duration","sessionId","view"]},"cl.PresentationEnded":{$schema:"http://json-schema.org/draft-07/schema#",title:"PresentationEnded",description:"Migrated from CL event type: **SessionEnded**\n\nCategory: Context\n\nCriticality Level: L3\n\n[View CL documentation](https://manuals.netflix.net/view/cltypes/mkdocs/master/classes/cl.sessionended.html)\n\nEnding event for: Presentation (merged with SessionEnded)",type:"object",properties:{browsingExperience:{type:"string",description:"Browsing experience metadata"},connectionType:{type:"string",description:"Network connection type (e.g., WifiConnection, MobileConnection, WiredConnection)"},deviceLocale:{type:"string",description:"Device locale/language setting (e.g., en-US, es-ES)"},duration:{type:"integer","ntl-type":"int64",minimum:0,description:"Time elapsed while the session existed (computed as [[SessionEnded.time]] - [[Session.time]]). %minimum(0)%"},genreId:{type:"integer","ntl-type":"int64",description:"Genre identifier for the content context"},isKids:{type:"integer","ntl-type":"int32",minimum:-0x80000000,maximum:0x7fffffff,description:"Kids profile indicator"},lolomoId:{type:"string",description:"Lolomo ID for presentation context"},navigationLevel:{type:"string",description:"Navigation level from session context"},nonmemberSharedUuid:{type:"string",format:"uuid",description:"Nonmember shared UUID for non-member identity tracking"},pulsePageId:{type:"string",description:"Pulse page identifier"},referrerUrl:{type:"string",description:"Referrer URL of the webpage where the event occurred"},searchOriginEntity:{type:"string",format:"unified-entity-id",description:"Entity identifier for the search result origin"},searchQuery:{type:"string",description:"User search query text"},sessionId:{type:"string",description:"Identifies the ended session (matches the [[Session.id]] field of the [[Session]] event that signalled the start of the session)."},trackingInfo:{type:"object",properties:{affordanceValues:{type:"array",items:{type:"string",enum:["MoreInfoButton","PlayButton","RemindMeButton","WatchLiveButton"]},description:"%minItems(1)%"},contextualMetadataToken:{type:"string",description:"Unique identifier for server-side entity logging context. Successor to [[entityLogContextId]]; added additively so producers and consumers can migrate before the old field is removed."},contextualThemeId:{type:"string",minLength:1,description:'Identifier of the contextual theme (produced by the Visual Effects Paved Path, aka "VEPP") that was presented for this view. Set only when a contextual theme was actually presented (i.e. applied and shown by the client UI layer); absent when the standard, un-themed treatment was presented. Used to determine which theme treatment each device received — e.g. distinguishing a themed billboard from a normal one. %minLength(1)%'},currentUuid:{type:"string",minLength:34,description:"The uuid associated with the current session or entity being tracked."},deviceTypeId:{type:"integer","ntl-type":"int64",minimum:1,description:"%minimum(1)%"},evidenceKey:{type:"string",format:"evidencekey",description:'%format("evidencekey")%'},gameReleasePlatformId:{type:"integer","ntl-type":"int64",description:"The id of the release platform associated with the game."},imageKey:{type:"string",format:"imagekey",description:'%format("imagekey")%'},listId:{type:"string",format:"listid",description:'%format("listid")%'},locale:{type:"string",format:"locale",description:'%format("locale")%'},lolomoId:{type:"string",minLength:1,description:"%minLength(1)%"},menuIndex:{type:"integer","ntl-type":"int64",minimum:0,description:"Zero-based index of an item within an expanded dropdown or sub-menu (e.g. the Category chip drop-down in the Mobile Content Bar). #### [Logging Specification](https://docs.google.com/document/d/13PfFTxq4GSXMNntsTd_BHabL9V1jp0SIqJ9MKbXVsrU/edit?tab=t.tzqar06hkex0#heading=h.1w0yvf7sehqz) #### %minimum(0)%"},option:{type:"string",minLength:1,description:"%minLength(1)%"},rank:{type:"integer","ntl-type":"int64",minimum:0,description:"%minimum(0)%"},rankNum:{type:"integer","ntl-type":"int64",minimum:0,description:"%minimum(0)%"},referringGameTitleId:{type:"integer","ntl-type":"int64",description:'The "source" game title id of where the event originated. Used to track the source of the gameplay attempt, specifically for the case where a game is merched from a different game title.'},requestId:{type:"string",minLength:1,description:"%minLength(1)%"},row:{type:"integer","ntl-type":"int64",minimum:0,maximum:50,description:"%minimum(0)% %maximum(90)%"},rowNum:{type:"integer","ntl-type":"int64",minimum:0,maximum:50,description:"%minimum(0)% %maximum(90)%"},selectionType:{type:"string",enum:["focus","keydown","keyenter"]},sourceUuid:{type:"string",minLength:34,description:"The uuid of the source session or entity that led to the current one being tracked."},trackId:{type:"integer","ntl-type":"int64",minimum:1,description:"%minimum(1)%"},unifiedEntityId:{type:"string",format:"ueid",description:'%format("ueid")%'},videoId:{type:"integer","ntl-type":"int64",minimum:1,maximum:0x3b9ac9ff,description:"%minimum(1)% %maximum(999999999)%"}},description:"This interface points to a structured version of trackingInfo, use it whenever you want to validate the fields within this structure"},uiLocale:{type:"string",description:"Application UI locale/language setting (e.g., en-US, es-ES)"},userInput:{type:"string",description:"User input value (e.g., search text, slider value)"},view:{type:"string",description:"The presented view."},webpageUrl:{type:"string",description:"URL of the webpage where the event occurred"},playbackMode:{type:"string",enum:["linear","live","svod","unknown"],description:"Playback classification captured when this session starts. Because [[Presentation]] is a base session, this optional field is also available to all derived Presentation sessions; producers outside an approved playback contract leave it absent. The value remains immutable for the session's lifetime and terminal event. A missing value means the producer did not provide a classification; use [[PlaybackMode.unknown]] when classification is provided but unresolved."}},required:["duration","sessionId","view"]},"cl.Presented":{$schema:"http://json-schema.org/draft-07/schema#",title:"Presented",description:"Migrated from CL event type: **Presented**\n\nCategory: DiscreteEvent\n\nCriticality Level: L1\n\nType Hierarchy: Presented → DiscreteEvent\n\n[View CL documentation](https://manuals.netflix.net/view/cltypes/mkdocs/master/classes/cl.presented.html)",type:"object",properties:{browsingExperience:{type:"string",description:"Browsing experience metadata"},connectionType:{type:"string",description:"Network connection type (e.g., WifiConnection, MobileConnection, WiredConnection)"},contentMissing:{type:"boolean",description:"Indicates whether the view was presented fully rendered or not (e.g. a placeholder was displayed in place of the intended image)."},genreId:{type:"integer","ntl-type":"int64",description:"Genre identifier for the content context"},isKids:{type:"integer","ntl-type":"int32",minimum:-0x80000000,maximum:0x7fffffff,description:"Kids profile indicator"},lolomoId:{type:"string",description:"Lolomo ID for presentation context"},navigationLevel:{type:"string",description:"Navigation level from session context"},navigationLevelEventId:{type:"string",description:"Event ID from navigation-level page context"},navigationLevelVideoId:{type:"integer","ntl-type":"int64",minimum:1,maximum:0x3b9ac9ff,description:"Video ID from navigation-level page context"},referrerUrl:{type:"string",description:"Referrer URL of the webpage where the event occurred"},searchExperienceType:{type:"string"},searchOriginEntity:{type:"string",format:"unified-entity-id",description:"Entity identifier for the search result origin"},searchQuery:{type:"string",description:"User search query text"},trackingInfo:{type:"object",properties:{affordanceValues:{type:"array",items:{type:"string",enum:["MoreInfoButton","PlayButton","RemindMeButton","WatchLiveButton"]},description:"%minItems(1)%"},collectionId:{type:"integer","ntl-type":"int64"},contextualMetadataToken:{type:"string",description:"Unique identifier for server-side entity logging context. Successor to [[entityLogContextId]]; added additively so producers and consumers can migrate before the old field is removed."},contextualThemeId:{type:"string",minLength:1,description:'Identifier of the contextual theme (produced by the Visual Effects Paved Path, aka "VEPP") that was presented for this view. Set only when a contextual theme was actually presented (i.e. applied and shown by the client UI layer); absent when the standard, un-themed treatment was presented. Used to determine which theme treatment each device received — e.g. distinguishing a themed billboard from a normal one. %minLength(1)%'},currentUuid:{type:"string",minLength:34,description:"The uuid associated with the current session or entity being tracked."},deviceTypeId:{type:"integer","ntl-type":"int64",minimum:1,description:"%minimum(1)%"},edpRank:{type:"integer","ntl-type":"int32",minimum:-0x80000000,maximum:0x7fffffff,description:"The positional index of an item within an ordered list on the Episode Detail Page "},evidenceKey:{type:"string",format:"evidencekey",description:'%format("evidencekey")%'},gameReleasePlatformId:{type:"integer","ntl-type":"int64",description:"The id of the release platform associated with the game."},genreId:{type:"integer","ntl-type":"int64"},imageKey:{type:"string",format:"imagekey",description:'%format("imagekey")%'},kidsCharacterId:{type:"integer","ntl-type":"int64"},listId:{type:"string",format:"listid",description:'%format("listid")%'},locale:{type:"string",format:"locale",description:'%format("locale")%'},lolomoId:{type:"string",minLength:1,description:"%minLength(1)%"},menuIndex:{type:"integer","ntl-type":"int64",minimum:0,description:"Zero-based index of an item within an expanded dropdown or sub-menu (e.g. the Category chip drop-down in the Mobile Content Bar). #### [Logging Specification](https://docs.google.com/document/d/13PfFTxq4GSXMNntsTd_BHabL9V1jp0SIqJ9MKbXVsrU/edit?tab=t.tzqar06hkex0#heading=h.1w0yvf7sehqz) #### %minimum(0)%"},option:{type:"string",minLength:1,description:"%minLength(1)%"},personId:{type:"integer","ntl-type":"int64"},query:{type:"string"},rank:{type:"integer","ntl-type":"int64",minimum:0,description:"%minimum(0)%"},rankNum:{type:"integer","ntl-type":"int64",minimum:0,description:"%minimum(0)%"},referenceId:{type:"string"},referringGameTitleId:{type:"integer","ntl-type":"int64",description:'The "source" game title id of where the event originated. Used to track the source of the gameplay attempt, specifically for the case where a game is merched from a different game title.'},requestId:{type:"string",minLength:1,description:"%minLength(1)%"},row:{type:"integer","ntl-type":"int64",minimum:0,maximum:90,description:"%minimum(0)% %maximum(90)%"},rowNum:{type:"integer","ntl-type":"int64",minimum:0,maximum:50,description:"%minimum(0)% %maximum(90)%"},selectionType:{type:"string",enum:["focus","keydown","keyenter"]},sourceUuid:{type:"string",minLength:34,description:"The uuid of the source session or entity that led to the current one being tracked."},sourceVideoId:{type:"integer","ntl-type":"int64",minimum:1,maximum:0x3b9ac9ff},trackId:{type:"integer","ntl-type":"int64",minimum:1,description:"%minimum(1)%"},unifiedEntityId:{type:"string",format:"ueid",description:'%format("ueid")%'},videoId:{type:"integer","ntl-type":"int64",minimum:0,maximum:0x3b9ac9ff,description:"%minimum(1)% %maximum(999999999)%"}},description:"This interface points to a structured version of trackingInfo, use it whenever you want to validate the fields within this structure"},uiLocale:{type:"string",description:"Application UI locale/language setting (e.g., en-US, es-ES)"},userInput:{type:"string",description:"User input value (e.g., search text, slider value)"},verticalVideoFeedSessionId:{type:"string",minLength:34,description:"Session ID of the presented event (generated by the client) if the view is the verticalVideoFeedUI"},view:{type:"string",description:"The presented view."},webpageUrl:{type:"string",description:"URL of the webpage where the event occurred"},playbackMode:{type:"string",enum:["linear","live","svod","unknown"],description:"Playback classification at the time the view is presented. Because [[Presented]] is a base event, this optional field is also available to all derived Presented events; producers outside an approved playback contract leave it absent. A missing value means the producer did not provide a classification; use [[PlaybackMode.unknown]] when classification is provided but unresolved."}},required:["contentMissing","view"]},"cl.RenderNavigationLevel":{$schema:"http://json-schema.org/draft-07/schema#",title:"RenderNavigationLevel",description:"Migrated from CL event type: **RenderNavigationLevel**\n\nCategory: Session\n\nCriticality Level: L1\n\nType Hierarchy: RenderNavigationLevel → Action → Session\n\n[View CL documentation](https://manuals.netflix.net/view/cltypes/mkdocs/master/classes/cl.rendernavigationlevel.html)",type:"object",properties:{appStartType:{type:"string",enum:["cold","hot","warm"],description:"For initial renders after an app start, specify the type of app start. This differentiates Cold AppTTR, Warm AppTTR, and view-based TTR (when not specified)."},command:{type:"string",description:"Intent that resulted in logging this Action. This is a newly added field to support simplified schema. In order to be backwards compatible it is currently an optional value, however once all the logging follows simplified schema specification this will be made a required property"},parentView:{type:"string",description:"Name of the engaged parent view that triggered this action e.g. if more than one button with the same view name was clicked that triggered this action then the parent view name assigned to the button should be used here to distinguish between the two. However this field is optional and should only be used when the view by itself leads to ambiguity of where in the UI this action was triggered from."},switchedProfile:{type:"boolean",description:"For rendering lolomo after profiles gate, specify whether or not the active profile was switched."},view:{type:"string",description:"Name of the engaged view that triggered this action e.g. if a button was clicked that triggered this action then the view name assigned to the button should be used here. However this field is optional, if this action was triggered without engaging any view (e.g. a button or a boxArt) then this field should not be set."},actualTime:{type:"integer","ntl-type":"int64",minimum:0,description:"Actual time this event occurred, measured using the same clock used to determine the client send time in the logging envelope. %minimum(0)%"},trackingInfo:{type:"object",properties:{},description:"Server-defined tracking information, if applicable."},navigationLevel:{type:"string",description:"Navigation level from session context"},processStates:{type:"array",items:{type:"object",ntl:{sharedPropertyId:"netflix.ProcessState"}},description:"Ordered ProcessState context for the event (index 0 = first/oldest); each element has allocation, computation, interaction, an optional reason, and a string id"},webpageUrl:{type:"string",description:"URL of the webpage where the event occurred"},sessionId:{type:"string",description:"Identifier of this session, carried by the session start event and its session end events."}}},"cl.RenderNavigationLevelCanceled":{$schema:"http://json-schema.org/draft-07/schema#",title:"RenderNavigationLevelCanceled",description:"Migrated from CL event type: **SessionCanceled**\n\nCategory: SessionEnded\n\nCriticality Level: L3\n\nType Hierarchy: SessionCanceled → SessionEnded\n\n[View CL documentation](https://manuals.netflix.net/view/cltypes/mkdocs/master/classes/cl.sessioncanceled.html)\n\nEnding event for: RenderNavigationLevel (merged with SessionCanceled)",type:"object",properties:{appStartType:{type:"string",enum:["cold","hot","warm"],description:"For initial renders after an app start, specify the type of app start. This differentiates Cold AppTTR, Warm AppTTR, and view-based TTR (when not specified)."},command:{type:"string",description:"Intent that resulted in logging this Action. This is a newly added field to support simplified schema. In order to be backwards compatible it is currently an optional value, however once all the logging follows simplified schema specification this will be made a required property"},parentView:{type:"string",description:"Name of the engaged parent view that triggered this action e.g. if more than one button with the same view name was clicked that triggered this action then the parent view name assigned to the button should be used here to distinguish between the two. However this field is optional and should only be used when the view by itself leads to ambiguity of where in the UI this action was triggered from."},switchedProfile:{type:"boolean",description:"For rendering lolomo after profiles gate, specify whether or not the active profile was switched."},view:{type:"string",description:"Name of the engaged view that triggered this action e.g. if a button was clicked that triggered this action then the view name assigned to the button should be used here. However this field is optional, if this action was triggered without engaging any view (e.g. a button or a boxArt) then this field should not be set."},actualTime:{type:"integer","ntl-type":"int64",minimum:0,description:"Actual time this event occurred, measured using the same clock used to determine the client send time in the logging envelope. %minimum(0)%"},trackingInfo:{type:"object",properties:{},description:"Server-defined tracking information, if applicable."},navigationLevel:{type:"string",description:"Navigation level from session context"},processStates:{type:"array",items:{type:"object",ntl:{sharedPropertyId:"netflix.ProcessState"}},description:"Ordered ProcessState context for the event (index 0 = first/oldest); each element has allocation, computation, interaction, an optional reason, and a string id"},webpageUrl:{type:"string",description:"URL of the webpage where the event occurred"},duration:{type:"integer","ntl-type":"int64",minimum:0,description:"Time elapsed while the session existed (computed as [[SessionEnded.time]] - [[Session.time]]). %minimum(0)%"},reason:{type:"string",enum:["same_screen_interaction","user_navigated_away","user_exited_app","new_screen_started"],"ntl-enum-descriptions":{same_screen_interaction:"User scrolled or tapped on the same view before the render completed, but did not navigate away.",user_navigated_away:"User left the view. Examples: back action, tabbing away, tapping to another screen.",user_exited_app:"User left the app entirely. Examples: backgrounded, exited, switched to the device home screen, switched to another app.",new_screen_started:"A new screen or RenderNavigation session started above or replaced it without direct user action on this view. Examples: deep link stack construction, programmatic redirect, route replacement."},description:"A reason for canceling the RNL. See the 'RenderNavigationLevel End Reasons' proposal doc (https://docs.google.com/document/d/1MJsjdiGy6jZ-cggPm_7ScnnubwxNXik8KvfSp2LIYGQ/) for more details"},sessionId:{type:"string",description:"Identifies the ended session. Matches the sessionId of the session start event that began the sessi